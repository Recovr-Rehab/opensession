#!/usr/bin/env bash
# Tripwire for the SHARED OpenSession checkout (the self-hosted instance's main
# checkout): it is live and every session commits on the default branch here. A
# branch SWITCH (git checkout <other>) yanks the working tree out from under the
# running server and other sessions and orphans their un-pushed commits — the
# "sessions undoing each other's work" trap. Git has no pre-checkout veto, so
# this warns loudly (non-destructive) the instant HEAD leaves the default
# branch. Branch work must use a separate `git worktree`, never a switch in
# this checkout.
# Args: $1=prev_head $2=new_head $3=branch_flag (1 = branch checkout)
[ "$3" = "1" ] || exit 0
gitdir=$(git rev-parse --git-dir 2>/dev/null)
case "$gitdir" in */worktrees/*) exit 0 ;; esac   # ignore linked worktrees
default=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)
default="${default#origin/}"
default="${default:-main}"
branch=$(git symbolic-ref --short -q HEAD || echo "DETACHED")
if [ "$branch" != "$default" ]; then
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null || echo "this checkout")
  printf '\n\033[41m\033[97m  SHARED CHECKOUT SWITCHED OFF %s (now on: %s)  \033[0m\n' "$default" "$branch" >&2
  printf '  %s is the live, shared OpenSession checkout. Switch back NOW:\n' "$toplevel" >&2
  printf '      git checkout %s\n' "$default" >&2
  printf '  Branch work must use a separate `git worktree` — never a switch here.\n\n' >&2
fi
exit 0
