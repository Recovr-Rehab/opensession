# Runner-payload filesystem image for the `microvm` sandbox provider —
# Slice A of docs/sandboxes-phase1-brain-inside.md (payload-baked golden).
#
# Layers the full opensession runner payload on top of Dockerfile.workspace,
# reproducing the BOOTSTRAP layout (`bootstrapRemoteSandbox` in
# src/server/sandbox/adapters/bootstrap.ts) — NOT deploy/sandbox/Dockerfile's
# docker-image layout (system node/npm installs would leave the bootstrap's
# hardcoded user-local paths dangling):
#
#   ~/.bun/bin/bun                      user-local bun (REMOTE_BUN)
#   ~/.local/bin/claude                 claude.ai installer (REMOTE_CLAUDE)
#   ~/.bun/bin/opencode                 bun add -g opencode-ai@<pin> (REMOTE_OPENCODE)
#   /home/ubuntu/projects/opensession   SHALLOW GIT CLONE at the pinned sha —
#                                       `.git` is kept deliberately so the
#                                       in-VM runnerSha reconcile
#                                       (bootstrap.ts:549-584) can fetch and
#                                       check out a bumped pin instead of
#                                       silently freezing old code
#   ~/.bks-workspace-runtime            exact WORKSPACE_BOOTSTRAP_SIGNATURE
#   ~/.bks-bootstrapped                 exact bootstrapSignature() string
#
# With both markers baked, ensure()-time bootstrap short-circuits to a marker
# read (fast path); a pin bump between golden refreshes mismatches the marker
# and the normal in-VM bootstrap reconciles incrementally.
#
# Built by refresh-sandbox-golden.sh, which computes RUNNER_SHA and
# BOOTSTRAP_SIGNATURE from the live sandbox config via bootstrap.ts and
# passes the (possibly credential-carrying) clone URL as a BuildKit secret
# (id=runner_clone_url) so no token ever lands in an image layer or in
# `docker history`. After the clone the origin URL is scrubbed back to plain
# https: the golden is shared by every future sandbox and MUST stay
# credential-free — all credentials arrive per launch via makeRemoteLauncher.
# (Consequence, accepted for this slice: a runnerSha bump against a PRIVATE
# runner repo can't fetch inside the VM and fails the bootstrap loudly —
# refresh the golden instead. Per-boot token injection is a later slice.)
ARG BASE_IMAGE=opensession-workspace-microvm:latest
FROM ${BASE_IMAGE}

# Pins. OPENCODE_VERSION must match REMOTE_OPENCODE_VERSION (bootstrap.ts) —
# refresh-sandbox-golden.sh passes it explicitly, extracted from
# bootstrapSignature(). BUN_VERSION mirrors Dockerfile.workspace;
# CLAUDE_VERSION mirrors deploy/sandbox/Dockerfile (the bootstrap installs
# latest, but a golden build pins for reproducibility — the claude version is
# not part of the signature).
ARG OPENCODE_VERSION=1.17.15
ARG CLAUDE_VERSION=2.1.218
ARG BUN_VERSION=1.3.14
# Commit sha (or ref) the payload clone is pinned to. Required.
ARG RUNNER_SHA
# Exact bootstrapSignature() string for ~/.bks-bootstrapped. Required.
ARG BOOTSTRAP_SIGNATURE

USER ubuntu
WORKDIR /home/ubuntu

# User-local bun at ~/.bun/bin/bun (the workspace image's /usr/local/bun
# system install stays for generic guest tooling; the runner payload uses
# this one, exactly like a bootstrapped remote sandbox).
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && test "$(/home/ubuntu/.bun/bin/bun --version)" = "${BUN_VERSION}"

# Runner payload: shallow clone at the pinned sha. init+fetch (not `git
# clone`) because a bare sha can't be cloned directly — the same shape as the
# bootstrap's reconcile fetch. Origin token scrub: see header.
RUN --mount=type=secret,id=runner_clone_url,uid=1000 \
    set -eu; \
    test -n "${RUNNER_SHA}" || { echo "RUNNER_SHA build-arg is required" >&2; exit 1; }; \
    CLONE_URL="$(cat /run/secrets/runner_clone_url)"; \
    mkdir -p /home/ubuntu/projects; \
    git init -q /home/ubuntu/projects/opensession; \
    cd /home/ubuntu/projects/opensession; \
    git remote add origin "$CLONE_URL"; \
    git fetch --depth 1 origin "${RUNNER_SHA}"; \
    git checkout -q --detach FETCH_HEAD; \
    git remote set-url origin "$(git remote get-url origin | sed -E 's#^(https?://)[^@/]+@#\1#')"

# The slow layer (several minutes cold: full dep tree incl. the ~223MB
# vendored codex binary) — the whole point of baking it into the golden.
RUN cd /home/ubuntu/projects/opensession && /home/ubuntu/.bun/bin/bun install

# claude CLI at ~/.local/bin/claude.
RUN curl -fsSL https://claude.ai/install.sh | bash -s "${CLAUDE_VERSION}" \
    && installed="$(/home/ubuntu/.local/bin/claude --version)" \
    && case "${installed}" in \
         "${CLAUDE_VERSION}"|"${CLAUDE_VERSION} "*) echo "claude ${installed} OK" ;; \
         *) echo "claude version mismatch: got '${installed}', want ${CLAUDE_VERSION}"; exit 1 ;; \
       esac

# opencode at ~/.bun/bin/opencode via bun's global dir — same command as
# bootstrap.ts, same version assert.
RUN BUN_INSTALL=/home/ubuntu/.bun /home/ubuntu/.bun/bin/bun add -g "opencode-ai@${OPENCODE_VERSION}" \
    && v="$(/home/ubuntu/.bun/bin/opencode --version)" \
    && { [ "$v" = "${OPENCODE_VERSION}" ] || { echo "opencode version mismatch: got '$v', want ${OPENCODE_VERSION}"; exit 1; }; }

# ~/.claude seed (bootstrap parity).
RUN mkdir -p /home/ubuntu/.claude && printf '{}' > /home/ubuntu/.claude/settings.json

# Markers LAST, byte-identical to what bootstrap.ts writes:
# WORKSPACE_BOOTSTRAP_SIGNATURE (a bootstrap.ts constant — keep in sync) and
# the computed bootstrapSignature().
RUN set -eu; \
    test -n "${BOOTSTRAP_SIGNATURE}" || { echo "BOOTSTRAP_SIGNATURE build-arg is required" >&2; exit 1; }; \
    printf '%s' 'workspace-runtime-v1+bun' > /home/ubuntu/.bks-workspace-runtime; \
    printf '%s' "${BOOTSTRAP_SIGNATURE}" > /home/ubuntu/.bks-bootstrapped

ENV PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.local/bin:/usr/local/bun/bin:/usr/local/bin:/usr/bin:/bin

CMD ["sleep", "infinity"]
